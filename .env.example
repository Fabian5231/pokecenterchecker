# === PCAlerts Konfiguration ===
# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# Die zu ueberwachende Kategorie-URL (Pokemon Center Deutschland)
PC_URL=https://www.pokemoncenter.com/de-de/category/trading-card-game?category=elite-trainer-box%2Ctins

# Wie oft geprueft wird (in Sekunden). 90 = alle 1,5 Minuten.
# Nur der Startwert: das Intervall laesst sich in der Weboberflaeche aendern,
# der dort gesetzte Wert steht in der Datenbank und hat Vorrang.
CHECK_INTERVAL_SECONDS=90
# Grenzen fuer das im Frontend einstellbare Intervall.
INTERVAL_MIN_SECONDS=30
INTERVAL_MAX_SECONDS=86400

# Browser sichtbar (false) oder unsichtbar (true)?
# WICHTIG: Der Bot-Schutz (DataDome + Imperva) blockiert unsichtbare Browser.
# Auf einem Windows-PC mit angemeldeter Sitzung: false lassen.
# Auf einem Linux-Server ohne Bildschirm: true + xvfb verwenden (siehe README).
HEADLESS=false

# Browserfenster aus dem sichtbaren Bereich schieben, damit es nicht stoert
# (laeuft normal weiter, ist nur nicht sichtbar). true = unsichtbar am Rand.
BROWSER_OFFSCREEN=false

# === Telegram ===
# Von @BotFather bekommen (siehe telegram_setup Anleitung / README).
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID (mit "python get_chat_id.py" ermitteln).
TELEGRAM_CHAT_ID=

# Bei welchen Ereignissen benachrichtigen?
#   new       = neuer Artikel ist in der Liste aufgetaucht
#   restock   = ein Artikel wechselt von "ausverkauft" auf "verfuegbar"
# Mehrere mit Komma trennen.
NOTIFY_ON=new,restock

# === Drop-Alarm (Warteschlange / Seite nicht erreichbar) ===
# Bei einem Drop schaltet Pokemon Center Warteschlange + Captcha vor die Seite.
QUEUE_ALERT=true
# Solange die Stoerung anhaelt: fruehestens alle X Minuten erneut alarmieren.
QUEUE_ALERT_COOLDOWN_MINUTES=30
# Auffangnetz: auch alarmieren, wenn die Seite X Minuten am Stueck gar nicht
# erreichbar ist (blockiert/Fehler) - ohne dass eine Queue erkannt wurde.
UNREACHABLE_ALERT_AFTER_MINUTES=20
# Bei jeder fehlgeschlagenen Pruefung HTML + Screenshot nach .pw-diag/ schreiben
# (zum Nachsehen, was wirklich auf der Seite stand). DIAG_KEEP = wie viele.
SAVE_DIAGNOSTICS=true
DIAG_KEEP=20

# === Weboberflaeche ===
WEB_HOST=127.0.0.1
WEB_PORT=8080
